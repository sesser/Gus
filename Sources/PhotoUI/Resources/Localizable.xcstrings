{
  "sourceLanguage" : "en",
  "strings" : {
    "%@  %@" : {
      "comment" : "Template token menu item: the token's name, then the token",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@  %@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "Template field Insert menu: a token and its value for the first photo",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (%lld)" : {
      "comment" : "Preset import summary: a kind of setting and how many presets had it",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%lld)"
          }
        }
      }
    },
    "%@ (default)" : {
      "comment" : "RAW decoder version menu item; the argument is a version name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (default)"
          }
        }
      }
    },
    "%@ (machine learning)" : {
      "comment" : "Decoder pop-up item for the RAW decoder's machine learning version; the argument is the version, e.g. “9.dng”. Pattern of “%@ (default)”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (machine learning)"
          }
        }
      }
    },
    "%@ EV" : {
      "comment" : "Info tab: exposure compensation; the argument is a signed number such as +0.7",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ EV"
          }
        }
      }
    },
    "%@ MP · %@ × %@" : {
      "comment" : "Info tab Size row: megapixels, then width × height in pixels",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ MP · %@ × %@"
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "A copy's name (File ▸ Duplicate): the original's file name without its extension, then “copy”. Also its exported file's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copy"
          }
        }
      }
    },
    "%@ copy %lld" : {
      "comment" : "The name of a photo's second and later copies: the original's file name without its extension, “copy”, and a number from 2. Also its exported file's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ copy %2$lld"
          }
        }
      }
    },
    "%@ could not be ejected. It may still be in use." : {
      "comment" : "Import window; the argument is a card name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not be ejected. It may still be in use."
          }
        }
      }
    },
    "%@ has no edits" : {
      "comment" : "Tooltip of a group's check box; the argument is the group's name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no edits"
          }
        }
      }
    },
