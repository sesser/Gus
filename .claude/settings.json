{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(swift build)",
      "Bash(swift build *)",
      "Bash(swift test)",
      "Bash(swift test *)",
      "Bash(GOLDENS_REPORT=1 swift test *)",
      "Bash(LARGE_RENDER_TESTS=1 swift test *)",
      "Bash(CAMERA_RAW_SAMPLE=* swift test *)",
      "Bash(Scripts/build-app.sh)",
      "Bash(Scripts/build-app.sh *)",
      "Bash(./Scripts/build-app.sh)",
      "Bash(./Scripts/build-app.sh *)",
      "Bash(CONFIGURATION=debug Scripts/build-app.sh)",
      "Bash(CONFIGURATION=debug Scripts/build-app.sh *)",
      "Bash(swift run photocli *)",
      "Bash(swift run -c release photobench *)",
      "Bash(vtool -show-build *)"
    ],
    "ask": [
      "Bash(UPDATE_GOLDENS=1 swift test *)"
    ],
    "deny": [
      "Bash(xcodebuild *)"
    ]
  }
}
